# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Basic auth (most common for Planon datalake OData)
PLANON_USERNAME=
PLANON_PASSWORD=

# Alternative: bearer token. If set, this takes precedence over username/password.
# PLANON_TOKEN=

# Override only if the service root differs
# PLANON_BASE_URL=https://planon.calpoly.edu/datalake/odata
